{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm --prefix ../.. run build:contracts && npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "src": "/(fit-tempo-sw\\.js|manifest\\.webmanifest)", "headers": { "Cache-Control": "no-cache" }, "continue": true },
    { "src": "/api", "dest": "https://fit-tempo-api-staging.vercel.app/api" },
    { "src": "/api/(.*)", "dest": "https://fit-tempo-api-staging.vercel.app/api/$1" },
    { "handle": "filesystem" },
    { "src": "/(?!assets(?:/|$)|.*\\.[^/]+$).*", "dest": "/index.html" }
  ]
}
