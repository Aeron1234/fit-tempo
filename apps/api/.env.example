# Copy to .env.local for local development. These settings contain no credentials.
PORT=3001
FRONTEND_URL=http://localhost:5173
APP_MODE=local
FOOD_ADAPTER=fixtures
# Live development lookups require REDIS_URL and at least one provider.
# FOOD_ADAPTER=live
# USDA_API_KEY=
# OPEN_FOOD_FACTS_USER_AGENT=
AI_ADAPTER=disabled
EMAIL_ADAPTER=test-mailbox
SCHEDULER_MODE=manual-dry-run
# Phase 06 local authentication: set all three together against a migrated database.
# DATABASE_URL=
# JWT_ACCESS_SECRET=
# CSRF_SECRET=
# Phase 07 shared limits require a real Redis service; leave unset until configured.
# REDIS_URL=
# Phase 07 Supabase private bucket (backend-only S3 credentials); leave all unset until tested.
# STORAGE_PROVIDER=supabase
# STORAGE_ENDPOINT=
# STORAGE_REGION=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# Live integrations are not implemented in Phase 03.
# Configure private credentials only when enabling their later-phase adapters.
