# Copy to .env.local for local development. These settings contain no credentials.
PORT=3001
FRONTEND_URL=http://localhost:5173
APP_MODE=local
FOOD_ADAPTER=fixtures
# Live development lookups require REDIS_URL and at least one provider.
# FOOD_ADAPTER=live
# USDA_API_KEY=
# OPEN_FOOD_FACTS_USER_AGENT=
AI_ADAPTER=disabled
# Approved fixtures only. Both adapters require Redis.
# The synthetic mock requires APP_MODE=synthetic-demo. Groq also supports APP_MODE=local.
# GROQ_API_KEY=
# GROQ_MODEL=
EMAIL_ADAPTER=test-mailbox
# EMAILJS_SERVICE_ID=
# EMAILJS_PUBLIC_KEY=
# EMAILJS_PRIVATE_KEY=
# EMAILJS_VERIFY_TEMPLATE_ID=
# EMAILJS_RESET_TEMPLATE_ID=
# manual-dry-run previews settings. hobby-daily restricts settings to daily-batch options.
# Neither mode dispatches email in Phase 22.
SCHEDULER_MODE=manual-dry-run
# Server-only bearer secret, 32 to 256 visible ASCII characters.
# CRON_SECRET=
# Leave these unset for a read-only dry run. Inbox testing targets an explicitly authorized address only.
# NOTIFICATION_TEST_RECIPIENT=
# EMAILJS_REMINDER_TEMPLATE_ID=
# EMAILJS_SUMMARY_TEMPLATE_ID=
# Phase 06 local authentication: set all three together against a migrated database.
# DATABASE_URL=
# JWT_ACCESS_SECRET=
# CSRF_SECRET=
# Phase 07 shared limits require a real Redis service; leave unset until configured.
# REDIS_URL=
# Phase 07 Supabase private bucket (backend-only S3 credentials); leave all unset until tested.
# STORAGE_PROVIDER=supabase
# STORAGE_ENDPOINT=
# STORAGE_REGION=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# Live integrations are not implemented in Phase 03.
# Configure private credentials only when enabling their later-phase adapters.
